	measure 'Bucket %' =
			
			VAR BucketCount = [Customers in Bucket]
			VAR TotalCustomers = CALCULATE([Customers in Bucket], ALL(dim_customer[LTV Bucket]))
			RETURN DIVIDE(BucketCount, TotalCustomers, 0)
		displayFolder: Customer Segmentation
		lineageTag: bf7a2cd9-2f5e-4e99-ac9d-8cd64ebbd8d8

