	measure 'Total Products' = ```
			DISTINCTCOUNT(dim_product[product_id])
			
			```
		formatString: 0
		displayFolder: Product
		lineageTag: 1e312b43-44cc-4757-bd0b-ecce365a4de7

	measure 'Active Products' = ```
			
			CALCULATE(
			    [Total Products],
			    dim_product[is_active] = 1
			)
			
			```
		formatString: 0
		displayFolder: Product
		lineageTag: ff334ff8-7afa-4227-bdd6-3c3820ee8472

	measure 'ABC Classification' = ```
			
			VAR ProductRevenue = [Total Revenue]
			VAR AllProducts = ALLSELECTED(dim_product[product_name])
			VAR ProductRank = 
			    RANKX(
			        AllProducts, 
			        [Total Revenue], 
			        , 
			        DESC, 
			        DENSE
			    )
			VAR TotalProducts = COUNTROWS(AllProducts)
			VAR TopTwentyPercentThreshold = TotalProducts * 0.2
			VAR TopFiftyPercentThreshold = TotalProducts * 0.5
			RETURN
			SWITCH(
			    TRUE(),
			    ProductRank <= TopTwentyPercentThreshold, "A - Top 20%",
			    ProductRank <= TopFiftyPercentThreshold, "B - Middle 30%",
			    "C - Bottom 50%"
			)
			
			```
		displayFolder: Product
		lineageTag: 032f1d4f-eef0-463e-8b4d-6ba4d8e91b7e

	measure 'Days Since Last Sale' = ```
			
			VAR LastSaleDate = 
			    CALCULATE(
			        MAX(fact_sales[order_date]),
			        ALLEXCEPT(dim_product, dim_product[product_id])
			    )
			RETURN 
			DATEDIFF(LastSaleDate, MAX(fact_sales[order_date]), DAY)
			
			```
		formatString: 0
		displayFolder: Product
		lineageTag: 0163ea2d-925b-4385-bb38-ed6ca2ff7983

	measure 'Sales Velocity (Units/Day)' = ```
			
			VAR TotalUnits = SUM(fact_sales[quantity])
			VAR DaysActive = 
			    DATEDIFF(
			        MIN(fact_sales[order_date]),
			        MAX(fact_sales[order_date]),
			        DAY
			    ) + 1
			RETURN
			DIVIDE(TotalUnits, DaysActive, 0)
			
			```
		displayFolder: Product
		lineageTag: dc263028-670b-4afc-941c-a337ef6e6a76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Basket Size Opportunity' = ```
			
			VAR CurrentAvgItems = [Avg Items per Order]
			VAR TargetAvgItems = 1.5
			VAR CurrentRevenue = [Total Revenue]
			VAR RevenuePerItem = DIVIDE(CurrentRevenue, COUNTROWS(fact_sales), 0)
			VAR TotalOrders = [Total Orders]
			RETURN
			(TargetAvgItems - CurrentAvgItems) * TotalOrders * RevenuePerItem
			
			```
		displayFolder: Product
		lineageTag: 9f7cb54f-676f-4651-bf93-c23eb0b68249

		annotation PBI_FormatHint = {"isGeneralNumber":true}

