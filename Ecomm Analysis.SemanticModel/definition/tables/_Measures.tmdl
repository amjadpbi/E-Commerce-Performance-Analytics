	measure 'Customer LTV' = ```
			
			AVERAGEX(
			    VALUES(fact_sales[customer_id]),
			    [Total Revenue]
			)
			
			```
		displayFolder: Customer Segmentation
		lineageTag: fed6c687-b0c1-4831-968f-2c19b2fad287

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reactivation Revenue Opportunity' = ```
			
			VAR InactiveCustomers = [Inactive Customers 90d]
			VAR AvgOrderValue = [AOV]
			VAR AssumedConversionRate = 0.30
			RETURN
			InactiveCustomers * AvgOrderValue * AssumedConversionRate
			
			```
		displayFolder: Customer Segmentation
		lineageTag: 9e0e8bc4-dae9-489e-8b7d-7cddbb8a78b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inactive %' = DIVIDE([Inactive Customers 90d],[Customer Count],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Segmentation
		lineageTag: de1a7c84-cdbc-4ee6-9b9d-3ea87595c3ee

	measure 'Avg Customer Value' = AVERAGE(dim_customer[Monetary Value])
