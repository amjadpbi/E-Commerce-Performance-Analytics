		displayFolder: Revenue
		lineageTag: 0a9af19c-e0a6-450a-a35d-47b5a59ee7f9

	measure 'Customer Count' = DISTINCTCOUNT(fact_sales[customer_id])
		formatString: 0
		displayFolder: Customer Segmentation
		lineageTag: d7c667da-639b-47d3-acb7-d389dd66bc53

	measure 'Active Customers 30d' = ```
			
			CALCULATE(
			    [Customer Count],
			    fact_sales[order_date] >= MAX(fact_sales[order_date])- 30
			)
			
