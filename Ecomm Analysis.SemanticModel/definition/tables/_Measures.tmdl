table _Measures
	lineageTag: 7d90ae5e-80ff-44ea-a676-9b35e3913ead

	measure 'Total Revenue' = SUM(fact_sales[line_revenue])
		formatString: 0.00
		displayFolder: Revenue
		lineageTag: 2f3e6fdc-daff-4e49-956a-195f8c3555d7

	measure 'Gross Profit' = SUM(fact_sales[gross_profit])
		displayFolder: Revenue
		lineageTag: 0b79a080-b3e5-49ea-98ef-b48dca412f55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
		formatString: 0
		displayFolder: Orders
		lineageTag: 63e87e6c-c5cc-4017-a8af-89395a517f56

		annotation PBI_FormatHint = {"isDecimal":true}

	measure AOV =
			CALCULATE(
			    DIVIDE([Total Revenue],[Total Orders],0))
		displayFolder: Orders
		lineageTag: 4cb2a098-c593-4222-b77c-0b4db13f602b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Items per Order' = ```
			
			DIVIDE(
			    COUNTROWS(fact_sales), 
			    [Total Orders], 
			    0
			)
			
			```
		displayFolder: Orders
		lineageTag: 770b498f-f7c9-4d14-9ea8-455529e490a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Return Rate %' = ```
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_sales), fact_sales[is_return] = 1),
			    COUNTROWS(fact_sales),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Orders
		lineageTag: 3c70d002-94b6-4d07-b3ff-4a953e072ee0

	measure 'MTD Revenue' = TOTALMTD(SUM(fact_sales[line_revenue]),dim_date[date])
		displayFolder: Revenue
		lineageTag: 68b25547-68ae-464c-9608-4440588e1701

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous MTD' = ```
			
			VAR MaxDate = MAX(dim_date[date])
			VAR StartDate = EOMONTH(MaxDate, -2) + 1
			VAR EndDate =
			    MIN(
			        EOMONTH(StartDate, 0),
			        DATE(YEAR(StartDate), MONTH(StartDate), DAY(MaxDate))
			    )
			RETURN
			CALCULATE(
			    SUM(fact_sales[line_revenue]),
			    ALL(dim_date),
			    fact_sales[order_date] >= StartDate,
			    fact_sales[order_date] <= EndDate
			)
			
			```
		displayFolder: Revenue
		lineageTag: e232e2bd-5033-4d67-ac2d-b4adb40e7753

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Growth %' = ```
			
			VAR _perc = 
			DIVIDE(
			    [MTD Revenue] - [Previous MTD],
			    [Previous MTD],
			    0
			)
			VAR _foramt = 
			SWITCH(
			    TRUE(),
			_perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
			_perc < 0, UNICHAR(11167) & " " & FORMAT(_perc*-1, "0.0%"),
			FORMAT(_perc, "0.0%")
			)
			RETURN _foramt
			
			```
		displayFolder: Revenue
		lineageTag: a2e072c7-14b2-499c-bdf4-31aae4b45b5f

	measure 'Gross Margin %' =
			
			DIVIDE(SUM(fact_sales[gross_profit]),SUM(fact_sales[line_revenue]),0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Revenue
		lineageTag: a00a8713-861a-4373-ae4f-8947589cb961

	measure 'YTD Revenue' = TOTALYTD(SUM(fact_sales[line_revenue]),fact_sales[order_date])
		displayFolder: Revenue
		lineageTag: 06cca473-8b9b-4c87-a3d7-db320bac34b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LY YTD' = ```
			
			VAR MaxDate = MAX(dim_date[date])
			RETURN
			CALCULATE(
			    SUM(fact_sales[line_revenue]),
			    ALL(dim_date),   -- 🔑 remove current-year filter
			    DATESBETWEEN(
			        dim_date[date],
			        DATE(YEAR(MaxDate) - 1, 1, 1),
			        DATE(YEAR(MaxDate) - 1, MONTH(MaxDate), DAY(MaxDate))
			    )
			)
			
			```
		displayFolder: Revenue
		lineageTag: 5b3aa722-4a3f-44dd-bc14-f2857739c550

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vs Last Month' = ```
			
			VAR _CM = [Total Revenue]
			VAR _PM = 
			CALCULATE([Total Revenue],
			DATEADD(fact_sales[order_date],-1,MONTH))
			
			RETURN _PM
			```
		displayFolder: Revenue
		lineageTag: a1568ca6-038b-4bbb-ab46-acf2de30589a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Growth %' = ```
			
			VAR _perc = 
			DIVIDE(
			    [YTD Revenue] - [LY YTD],
			    [LY YTD],
			    0
			)
			VAR _foramt = 
			SWITCH(
			    TRUE(),
			_perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
			_perc < 0, UNICHAR(11167) & " " & FORMAT(_perc*-1, "0.0%"),
			FORMAT(_perc, "0.0%")
			)
			RETURN _foramt
			
			```
		displayFolder: Revenue
		lineageTag: 97cb846b-c8fe-4e5f-a142-28733c0b7ad7

	measure 'MoM formating' = ```
			
			VAR _perc = 
			DIVIDE(
			    [MTD Revenue] - [Previous MTD],
			    [Previous MTD],
			    0
			)
			VAR _foramt = 
			SWITCH(
			    TRUE(),
			_perc > 0, "Green",
			_perc < 0, "Red",
			"Grey"
			)
			RETURN _foramt
			```
		displayFolder: Revenue
		lineageTag: ca4eefe1-acdf-4ed8-976e-04b56d515b5c

	measure 'YoY formating' = ```
			
			VAR _perc = 
			DIVIDE(
			    [YTD Revenue] - [LY YTD],
			    [LY YTD],
			    0
			)
			VAR _foramt = 
			SWITCH(
			    TRUE(),
			_perc > 0, "Green",
			_perc < 0, "Red",
			"Red"
			)
			RETURN _foramt
			```
		displayFolder: Revenue
		lineageTag: e8daad77-9741-4dc3-bb64-4247dddfd44f

	measure 'Returned Order Count' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(fact_sales[order_id]),
			    FILTER(
			        fact_sales,
			        fact_sales[is_return] = 1
			    )
			)
			
			```
		formatString: 0
		displayFolder: Orders
		lineageTag: 461b6a19-9a64-4f92-92bd-5c5ed0849dac

	measure 'Revenue with Discount' = ```
			
			CALCULATE([Total Revenue], fact_sales[discount_pct] > 0)
			
