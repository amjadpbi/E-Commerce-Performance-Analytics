	measure 'Inactive Customers 90d' = ```
			
			CALCULATE(
			    [Customer Count],
			    FILTER(
			        VALUES(fact_sales[customer_id]),
			        CALCULATE(MAX(fact_sales[order_date])) < MAX(fact_sales[order_date]) - 90
			    )
			)
			
			```
		formatString: 0
		displayFolder: Customer Segmentation
		lineageTag: 12bc369b-c49a-4c74-9e49-39ef256327ec

	measure 'Inactive Customers 180d' = ```
			
			CALCULATE(
			    [Customer Count],
			    FILTER(
			        VALUES(fact_sales[customer_id]),
			        CALCULATE(MAX(fact_sales[order_date])) < MAX(fact_sales[order_date]) - 180
