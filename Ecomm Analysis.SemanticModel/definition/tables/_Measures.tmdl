	measure 'Baseline Revenue' = ```
			
			VAR CampaignStartDate = MIN(dim_campaign[start_date])
			VAR CampaignEndDate = MAX(dim_campaign[end_date])
			VAR BeforeCampaignRevenue = 
			    CALCULATE(
			        [Total Revenue],
			        fact_sales[order_date] < CampaignStartDate,
			        DATESINPERIOD(
			            dim_date[date],
			            CampaignStartDate - 1,
			            -30,
			            DAY
			        )
			    ) / 30
			RETURN
			BeforeCampaignRevenue
			
			```
		displayFolder: Revenue
		lineageTag: fe59c619-d300-4b78-bef4-da9b761df8ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customers in Bucket' =
			
