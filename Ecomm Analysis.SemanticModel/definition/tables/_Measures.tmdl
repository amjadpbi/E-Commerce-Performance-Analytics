	measure 'Cohort Size' = ```
			
			VAR CurrentCohort = SELECTEDVALUE(dim_customer[Cohort Month])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(dim_customer[customer_id]),
			        dim_customer[Cohort Month] = CurrentCohort,
			        ALL(fact_sales)
			    )
			
			```
		formatString: 0
		displayFolder: Customer Segmentation
		lineageTag: d7006515-8d81-4a2b-be7c-ba495fafc8bf

	measure 'Active Customers in Period' = ```
			
			DISTINCTCOUNT(fact_sales[customer_id])
			
			
			```
		formatString: 0
