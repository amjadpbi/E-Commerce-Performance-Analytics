	measure 'Inactive card subtitleInactive vs Last Month' = ```
			
			VAR CurrentInactive = [Inactive Customers 90d]
			VAR LastMonthInactive = 
			    CALCULATE(
			        [Inactive Customers 90d],
			        DATEADD(dim_date[date], -1, MONTH)
			    )
			RETURN 
			    CurrentInactive - LastMonthInactive
			```
		formatString: 0
		displayFolder: Customer Segmentation
		lineageTag: 9f61b67b-98c8-486a-bb94-470b6932f600

